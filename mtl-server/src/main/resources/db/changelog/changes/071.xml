<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">

    <changeSet id="20260901_1_google_health_oauth_lifecycle" author="codex">
        <comment>Persist OAuth expiry and pagination-loop protection state.</comment>
        <addColumn schemaName="google_health" tableName="connection">
            <column name="refresh_token_expires_at" type="timestamptz"/>
        </addColumn>
        <addColumn schemaName="google_health" tableName="sync_state">
            <column name="active_page_count" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="google_health" tableName="sync_state" columnName="active_page_count"/>
            <dropColumn schemaName="google_health" tableName="connection" columnName="refresh_token_expires_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
