<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">
    <changeSet id="20260930_metabolic_coverage_reasons" author="codex">
        <comment>Store coverage explanations for new imports and normal energy recalculations.</comment>
        <addColumn tableName="gps_track">
            <column name="metabolic_recording_gap_seconds" type="double precision"/>
            <column name="metabolic_sparse_sampling_seconds" type="double precision"/>
            <column name="metabolic_unknown_duration" type="boolean"/>
            <column name="metabolic_exclusion_reasons" type="varchar(512)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
