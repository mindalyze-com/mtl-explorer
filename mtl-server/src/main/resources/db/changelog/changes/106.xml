<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">
    <changeSet id="20261011_client_diagnostics" author="codex">
        <addColumn tableName="system_log">
            <column name="source" type="varchar(16)"/>
            <column name="severity" type="varchar(16)"/>
            <column name="stack_trace" type="text"/>
            <column name="context_json" type="jsonb"/>
            <column name="build_id" type="varchar(128)"/>
            <column name="client_login_ref" type="varchar(32)"/>
        </addColumn>
        <dropNotNullConstraint tableName="system_log" columnName="topic1" columnDataType="varchar(255)"/>
        <createIndex tableName="system_log" indexName="system_log_login_date_ix">
            <column name="client_login_ref"/>
            <column name="create_date"/>
        </createIndex>
        <createIndex tableName="system_log" indexName="system_log_classification_date_ix">
            <column name="source"/>
            <column name="severity"/>
            <column name="create_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
